@inherits DraftSubscriber

@if (Draft.Exam is { } exam)
{
    var count = exam.QuestionCount();
    <span class="totals-badge" title="عدد الأسئلة ومجموع العلامات">
        <span>@(count == 0 ? "لا توجد أسئلة" : ArabicText.Questions(count))</span>
        <span class="totals-separator" aria-hidden="true">·</span>
        <span>المجموع: @ArabicText.Marks(exam.TotalMarks())</span>
    </span>
}
