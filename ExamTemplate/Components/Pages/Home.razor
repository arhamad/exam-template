@page "/"
@inject ExamDraftState Draft
@inject BrowserInterop Browser
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>@Ui.Text("مولّد الامتحانات", "Exam Generator")</PageTitle>

<header class="page-header home-hero">
    <img src="images/qou-logo.png" alt="" width="72" height="70" class="home-logo"/>
    <div>
        <h1>@Ui.Text("مولّد الامتحانات", "Exam Generator")</h1>
        <p class="page-lead">
            @Ui.Text("أنشئ امتحانًا بأسئلة اختيار من متعدد وصح أو خطأ وأسئلة مقالية، ثم ولّد منه حتى أربعة نماذج مخلوطة مع مفاتيح الإجابة بصيغتي Word وPDF.",
                "Create an exam with multiple-choice, true-or-false and essay questions, then generate up to four shuffled versions with their answer keys, as Word and PDF files.")
        </p>
    </div>
</header>

@if (loading)
{
    <div class="loading-state" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        @Ui.Text("جارٍ البحث عن مسودة محفوظة…", "Looking for a saved draft…")
    </div>
}
else
{
    @if (message is not null)
    {
        <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
            @message
            <button type="button" class="btn-close" aria-label="@Ui.Text("إغلاق", "Close")" @onclick="() => message = null"></button>
        </div>
    }

    @if (Draft.RestoreError is { } restoreError)
    {
        <div class="alert alert-warning" role="alert">@restoreError</div>
    }

    @if (Draft.Exam is { } exam)
    {
        var questionCount = exam.QuestionCount();
        <section class="panel draft-card" aria-labelledby="draft-title">
            <h2 id="draft-title" class="panel-title">@Ui.Text("متابعة المسودة الحالية", "Continue the current draft")</h2>
            <dl class="draft-facts">
                <div>
                    <dt>@Ui.Text("المقرر", "Course")</dt>
                    <dd>
                        <span dir="auto">@(string.IsNullOrWhiteSpace(exam.Header.CourseName) ? Ui.Text("بلا اسم", "Untitled") : exam.Header.CourseName)</span>
                        @if (!string.IsNullOrWhiteSpace(exam.Header.CourseCode))
                        {
                            <span class="text-body-secondary ms-1" dir="ltr">(@exam.Header.CourseCode)</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>@Ui.Text("المحتوى", "Content")</dt>
                    <dd>
                        @Ui.Join(questionCount == 0
                            ? [Ui.Text("لا توجد أسئلة", "No questions"), Ui.Marks(exam.TotalMarks())]
                            : [Ui.Questions(exam.MainQuestionCount()), Ui.Items(questionCount), Ui.Marks(exam.TotalMarks())])
                    </dd>
                </div>
                <div>
                    <dt>@Ui.Text("آخر حفظ", "Last saved")</dt>
                    <dd>@SavedAtText</dd>
                </div>
            </dl>
            <div class="button-row">
                <a class="btn btn-primary" href="exam/details">@Ui.Text("متابعة التحرير", "Continue editing")</a>
                <a class="btn btn-outline-primary" href="exam/generate">@Ui.Text("التوليد والتصدير", "Generate and export")</a>
                <button type="button" class="btn btn-outline-danger ms-sm-auto" disabled="@busy" @onclick="DeleteDraftAsync">
                    <Icon Name="trash"/> @Ui.Text("حذف المسودة", "Delete draft")
                </button>
            </div>
        </section>
    }

    <section class="panel" aria-labelledby="start-title">
        <h2 id="start-title" class="panel-title">@(Draft.Exam is null ? Ui.Text("ابدأ", "Start") : Ui.Text("أو ابدأ امتحانًا آخر", "Or start another exam"))</h2>
        <div class="start-options">
            <button type="button" class="start-option" disabled="@busy" @onclick="CreateNewAsync">
                <Icon Name="plus" Class="start-icon"/>
                <span class="start-title">@Ui.Text("امتحان جديد", "New exam")</span>
                <span class="start-text">@Ui.Text("امتحان باللغة العربية: قسم فارغ مع التعليمات الافتراضية.", "An English exam: one empty section with the default instructions.")</span>
            </button>

            <label class="start-option @(busy ? "is-disabled" : null)">
                <Icon Name="upload" Class="start-icon"/>
                <span class="start-title">@Ui.Text("استيراد ملف امتحان (JSON)", "Import an exam file (JSON)")</span>
                <span class="start-text">@Ui.Text("ملف صدّرته سابقًا من هذا التطبيق، حتى 5 ميغابايت.", "A file you exported from this app before, up to 5 MB.")</span>
                <InputFile @key="importInputKey" class="visually-hidden" accept=".json,application/json"
                           disabled="@busy" OnChange="ImportAsync"/>
            </label>

            <button type="button" class="start-option" disabled="@busy" @onclick="() => LoadSampleAsync(DemoExams.ComputerLogicDesign)">
                <Icon Name="sample" Class="start-icon"/>
                <span class="start-title">@Ui.Text("تحميل نموذج تجريبي", "Sample exam in Arabic")</span>
                <span class="start-text">
                    @Ui.Text("امتحان «تصميم منطق الحاسوب»: ثلاثة أقسام وثمانية أسئلة ونموذجان.",
                        "The Computer Logic Design exam: three sections, eight questions and two versions, printed right to left.")
                </span>
            </button>

            <button type="button" class="start-option" disabled="@busy" @onclick="() => LoadSampleAsync(DemoExams.ComputerLogicDesignEnglish)">
                <Icon Name="sample" Class="start-icon"/>
                <span class="start-title">@Ui.Text("نموذج تجريبي بالإنجليزية", "Sample exam in English")</span>
                <span class="start-text">
                    @Ui.Text("الامتحان نفسه باللغة الإنجليزية، ويُطبع من اليسار إلى اليمين.", "The same exam in English, printed left to right.")
                </span>
            </button>

            <button type="button" class="start-option" disabled="@busy" @onclick="() => LoadSampleAsync(DemoExams.OptionalPair)">
                <Icon Name="sample" Class="start-icon"/>
                <span class="start-title">@Ui.Text("نموذج بسؤالين اختياريين", "Sample exam with an optional pair")</span>
                <span class="start-text">
                    @Ui.Text("ستة أسئلة رئيسية: موضوعية مرقّمة، مقالية بفروع أ، ب، ج، والطالب يجيب عن الخامس أو السادس.",
                        "Six main questions: numbered objective sections, essays with parts a, b, c, and a choice between the fifth and the sixth.")
                </span>
            </button>
        </div>
    </section>

    <p class="storage-note">
        <Icon Name="warning"/>
        <span>
            @Ui.Text("تُحفظ المسودة تلقائيًا في هذا المتصفح فقط ولا تُخزَّن على الخادم. للاحتفاظ بنسخة أو للعمل من جهاز آخر استخدم «تصدير ملف الامتحان (JSON)» في صفحة التوليد والتصدير، واحذف المسودة بعد الانتهاء إن كان الجهاز مشتركًا.",
                "The draft is saved automatically in this browser only, never on the server. To keep a copy or to work on another computer, use “Export exam file (JSON)” on the Generate and export page, and delete the draft when you finish on a shared computer.")
        </span>
    </p>
}

@code {
    // Same limit as the browser draft, so an exported exam at the largest allowed size can be imported again.
    private const long MaxImportBytes = BrowserInterop.MaxDraftBytes;

    private bool loading = true;
    private bool busy;
    private int importInputKey;
    private DraftInfo? storedInfo;
    private string? message;
    private bool messageIsError;

    private string SavedAtText => Draft.SaveStatus switch
    {
        DraftSaveStatus.Pending or DraftSaveStatus.Saving => Ui.Text("جارٍ الحفظ…", "Saving…"),
        DraftSaveStatus.Failed => Ui.Text("تعذّر الحفظ في المتصفح", "Couldn't save in the browser"),
        _ when !string.IsNullOrEmpty(storedInfo?.SavedAtText) => storedInfo.SavedAtText,
        _ => Ui.Text("غير معروف", "Unknown"),
    };

    protected override async Task OnInitializedAsync()
    {
        await Draft.EnsureLoadedAsync();
        if (Draft.Exam is not null)
            storedInfo = await TryGetDraftInfoAsync();
        loading = false;
    }

    private async Task CreateNewAsync()
    {
        if (!await ConfirmReplaceAsync())
            return;

        // Starts in the interface language; the exam language can be changed on the details page.
        Draft.Replace(ExamDefinition.CreateNew(Ui.NewExamLanguage));
        Navigation.NavigateTo("exam/details");
    }

    private async Task LoadSampleAsync(Func<ExamDefinition> sample)
    {
        if (!await ConfirmReplaceAsync())
            return;

        Draft.Replace(sample());
        Navigation.NavigateTo("exam/questions");
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        message = null;
        ExamDefinition exam;

        busy = true;
        try
        {
            if (e.File.Size > MaxImportBytes)
            {
                ShowError(Ui.Text("حجم الملف أكبر من 5 ميغابايت، ولا يمكن استيراده.", "The file is larger than 5 MB and can't be imported."));
                return;
            }

            await using var stream = e.File.OpenReadStream(MaxImportBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            exam = ExamJson.Deserialize(buffer);
        }
        catch (ExamJsonException exception)
        {
            ShowError(Ui.Text(exception.UserMessage));
            return;
        }
        catch (Exception exception) when (exception is not JSDisconnectedException)
        {
            Logger.LogWarning(exception, "Importing the exam file {FileName} failed.", e.File.Name);
            ShowError(Ui.Text(
                "تعذّرت قراءة الملف. تأكد من أنه ملف امتحان صدّرته من هذا التطبيق ثم حاول مرة أخرى.",
                "The file couldn't be read. Make sure it's an exam file exported from this app, then try again."));
            return;
        }
        finally
        {
            busy = false;
            // A new input element, so choosing the same file again raises a change event.
            importInputKey++;
        }

        if (!await ConfirmReplaceAsync())
            return;

        Draft.Replace(exam);
        Navigation.NavigateTo("exam/questions");
    }

    private async Task DeleteDraftAsync()
    {
        var confirmed = await Browser.ConfirmAsync(Ui.Text(
            "حذف المسودة نهائيًا من هذا المتصفح؟ لا يمكن التراجع عن ذلك؛ صدّر ملف JSON أولًا إن أردت الاحتفاظ بنسخة.",
            "Delete the draft from this browser for good? This can't be undone; export a JSON file first if you want to keep a copy."));
        if (!confirmed)
            return;

        busy = true;
        var deleted = await Draft.DiscardAsync();
        busy = false;
        storedInfo = null;

        if (deleted)
            ShowSuccess(Ui.Text("حُذفت المسودة من هذا المتصفح.", "The draft was deleted from this browser."));
        else
            ShowError(Ui.Text("أُغلق الامتحان، لكن تعذّر حذف المسودة من تخزين المتصفح.", "The exam was closed, but the draft couldn't be deleted from the browser's storage."));
    }

    private async Task<bool> ConfirmReplaceAsync()
    {
        if (Draft.Exam is not null)
        {
            return await Browser.ConfirmAsync(Ui.Text(
                "سيحلّ الامتحان الجديد محلّ المسودة الحالية، ولن يمكن استعادتها إلا من ملف JSON مُصدَّر. هل تريد المتابعة؟",
                "The new exam will replace the current draft, which can only be recovered from an exported JSON file. Continue?"));
        }

        if (Draft.RestoreError is not null)
        {
            return await Browser.ConfirmAsync(Ui.Text(
                "ستُستبدل المسودة المحفوظة التي تعذّرت قراءتها. هل تريد المتابعة؟",
                "The saved draft that couldn't be read will be replaced. Continue?"));
        }

        return true;
    }

    private async Task<DraftInfo?> TryGetDraftInfoAsync()
    {
        try
        {
            return await Browser.GetDraftInfoAsync(Ui.DateLocale);
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Reading the draft summary from the browser failed.");
            return null;
        }
    }

    private void ShowError(string text) => (message, messageIsError) = (text, true);

    private void ShowSuccess(string text) => (message, messageIsError) = (text, false);
}
