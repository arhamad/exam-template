@page "/exam/questions"
@inherits ExamPageBase

<PageTitle>@Ui.Text("الأسئلة – مولّد الامتحانات", "Questions – Exam Generator")</PageTitle>

<header class="page-header">
    <h1>@Ui.Text("الأسئلة", "Questions")</h1>
    <p class="page-lead">
        @Ui.Text("كل قسم سؤال رئيسي على الورقة، ويبدأ ترقيم أسئلته من 1؛ القسم الذي كل أسئلته مقالية تُسمَّى أسئلته بالحروف أ، ب، ج. عند توليد أكثر من نموذج تُخلط الأسئلة داخل قسمها فقط، وتُخلط خيارات أسئلة الاختيار من متعدد ما لم تُثبَّت.",
            "Each section is one main question on the paper, and its questions are numbered from 1; in a section made only of essays they are lettered a, b, c. When more than one version is generated, questions are shuffled only within their section, and multiple-choice options are shuffled unless their order is kept.")
    </p>
</header>

@if (IsLoading)
{
    <div class="loading-state" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        @Ui.Text("جارٍ تحميل المسودة…", "Loading the draft…")
    </div>
}
else if (Exam is not { } exam)
{
    <NoExamNotice/>
}
else
{
    <FieldIssues Issues="ExamLevelIssues" Id="issues-Sections"/>

    for (var index = 0; index < exam.Sections.Count; index++)
    {
        var section = exam.Sections[index];
        <SectionEditor @key="section.Id" Exam="exam" Section="section" Index="index" OnStructureChanged="StructureChanged"/>
    }

    @if (exam.Sections.Count == 0)
    {
        <div class="empty-state mb-3">
            <p class="mb-0">@Ui.Text("لا توجد أقسام. أضف قسمًا لتبدأ كتابة الأسئلة.", "There are no sections. Add a section to start writing questions.")</p>
        </div>
    }

    <div class="add-section-bar">
        <button id="section-add" type="button" class="btn btn-outline-primary"
                disabled="@(exam.Sections.Count >= ExamLimits.MaxSections)" @onclick="AddSection">
            <Icon Name="plus"/> @Ui.Text("إضافة قسم", "Add section")
        </button>
        @if (exam.Sections.Count >= ExamLimits.MaxSections)
        {
            <span class="form-hint">@Ui.Text($"الحد الأقصى {ExamLimits.MaxSections} قسمًا.", $"The limit is {ExamLimits.MaxSections} sections.")</span>
        }
    </div>

    <StepFooter PreviousHref="exam/details" PreviousText="@Ui.Text("معلومات الامتحان", "Exam details")"
                NextHref="exam/generate" NextText="@Ui.Text("التوليد والتصدير", "Generate and export")"/>
}

@code {
    // Exam-wide content issues (no questions at all, answers clustered on one letter) once all issues are shown.
    private IEnumerable<ValidationIssue> ExamLevelIssues =>
        Draft.ShowAllIssues ? Draft.Validation.ForField(nameof(ExamDefinition.Sections)) : [];

    private void StructureChanged(string? focusId) => FocusAfterRender(focusId);

    private void AddSection()
    {
        if (Exam is null || Exam.Sections.Count >= ExamLimits.MaxSections)
            return;

        var section = new ExamSection();
        Exam.Sections.Add(section);
        Draft.NotifyChanged();
        FocusAfterRender($"s-{section.Id}-title-input");
    }
}
