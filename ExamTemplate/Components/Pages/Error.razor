@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageTitle>خطأ – مولّد الامتحانات</PageTitle>

<h1 class="text-danger">حدث خطأ</h1>
<p class="lead">تعذّرت معالجة طلبك. حاول مرة أخرى، أو عُد إلى الصفحة الرئيسية.</p>

@if (ShowRequestId)
{
    <p>
        <strong>معرّف الطلب:</strong> <code dir="ltr">@RequestId</code>
    </p>
}

<p class="text-body-secondary">
    لعرض تفاصيل الخطأ أثناء التطوير شغّل التطبيق في بيئة <strong dir="ltr">Development</strong>.
    لا تفعّل هذه البيئة في التطبيقات المنشورة لأنها قد تعرض معلومات حساسة للمستخدمين.
</p>

<a class="btn btn-primary" href="">الصفحة الرئيسية</a>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}
