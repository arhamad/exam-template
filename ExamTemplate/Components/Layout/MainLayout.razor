@inherits LayoutComponentBase

@* With dir="rtl" the sidebar (first flex item) sits on the right. This layout never subscribes to draft
   changes: the live parts (navigation, top bar) update on their own. *@
<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <TopBar/>

        <article class="content">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert">
                        <h1 class="h4">حدث خطأ غير متوقع في هذه الصفحة</h1>
                        <p>تُحفظ مسودتك تلقائيًا في هذا المتصفح. انتقل إلى صفحة أخرى أو أعد تحميل الصفحة للمتابعة.</p>
                        <a class="btn btn-outline-danger btn-sm" href="">الصفحة الرئيسية</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع.
    <a href="." class="reload">إعادة تحميل الصفحة</a>
    <span class="dismiss" role="button" aria-label="إغلاق">×</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // Navigating to another page clears an error shown by the previous one.
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
