@inherits LayoutComponentBase

@* The sidebar is the first flex item, so it sits at the start: on the right in Arabic and on the left in English. This
   layout never subscribes to draft changes: the live parts (navigation, top bar) update on their own. *@
<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <TopBar/>

        <article class="content">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert">
                        <h1 class="h4">@Ui.Text("حدث خطأ غير متوقع في هذه الصفحة", "An unexpected error occurred on this page")</h1>
                        <p>
                            @Ui.Text("تُحفظ مسودتك تلقائيًا في هذا المتصفح. انتقل إلى صفحة أخرى أو أعد تحميل الصفحة للمتابعة.",
                                "Your draft is saved automatically in this browser. Go to another page or reload this one to continue.")
                        </p>
                        <a class="btn btn-outline-danger btn-sm" href="">@Ui.Text("الصفحة الرئيسية", "Home page")</a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Ui.Text("حدث خطأ غير متوقع.", "An unexpected error occurred.")
    <a href="." class="reload">@Ui.Text("إعادة تحميل الصفحة", "Reload the page")</a>
    <span class="dismiss" role="button" aria-label="@Ui.Text("إغلاق", "Close")">×</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // Navigating to another page clears an error shown by the previous one.
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
