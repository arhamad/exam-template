<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            @Ui.Text("انقطع الاتصال بالخادم، جارٍ إعادة الاتصال…", "Lost the connection to the server. Reconnecting…")
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @Ui.Text("تعذّرت إعادة الاتصال… ستُعاد المحاولة خلال", "Couldn't reconnect… Trying again in")
            <span id="components-seconds-to-next-attempt"></span> @Ui.Text("ثانية.", "seconds.")
        </p>
        <p class="components-reconnect-failed-visible">
            @Ui.Text("تعذّرت إعادة الاتصال.", "Couldn't reconnect.")<br/>@Ui.Text("أعد المحاولة أو أعد تحميل الصفحة.", "Try again or reload the page.")
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            @Ui.Text("إعادة المحاولة", "Try again")
        </button>
        <p class="components-pause-visible">
            @Ui.Text("أوقف الخادم الجلسة مؤقتًا.", "The server paused the session.")
        </p>
        <p class="components-resume-failed-visible">
            @Ui.Text("تعذّر استئناف الجلسة.", "Couldn't resume the session.")<br/>@Ui.Text("أعد المحاولة أو أعد تحميل الصفحة.", "Try again or reload the page.")
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            @Ui.Text("استئناف", "Resume")
        </button>
    </div>
</dialog>
