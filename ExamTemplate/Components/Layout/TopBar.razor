@inherits DraftSubscriber

<header class="top-bar">
    @if (Draft.Exam is { } exam)
    {
        <div class="exam-identity">
            @* dir="auto": the course name is in the exam's language, which may differ from the interface's. *@
            <span class="exam-course" dir="auto">
                @(string.IsNullOrWhiteSpace(exam.Header.CourseName) ? Ui.Text("امتحان بلا اسم مقرر", "Exam without a course name") : exam.Header.CourseName)
            </span>
            @if (!string.IsNullOrWhiteSpace(exam.Header.CourseCode))
            {
                <span class="exam-code" dir="ltr">@exam.Header.CourseCode</span>
            }
        </div>
        <div class="top-bar-status">
            <ExamTotalsBadge/>
            <SaveStatus/>
        </div>
    }
    else
    {
        <span class="exam-identity text-body-secondary">@Ui.Text("لا يوجد امتحان مفتوح", "No exam is open")</span>
    }
    <LanguageSwitch/>
</header>
