<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.rtl.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["ExamTemplate.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
@* Shown until the interactive app renders its layout (pages aren't prerendered). *@
<div class="app-loading" role="status">
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    جارٍ تحميل التطبيق…
</div>
<Routes @rendermode="PageRenderMode"/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Not prerendered: pages restore the draft from the browser's localStorage, which the server can't read.
    private static readonly IComponentRenderMode InteractiveWithoutPrerendering = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (the error page) stay static.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveWithoutPrerendering : null;
}
