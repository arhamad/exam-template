@inherits DraftSubscriber

@* Live item count and marks of one section; updates while marks are edited in the cards below. *@
<span class="section-summary">
    @Ui.Join([Section.Questions.Count == 0 ? Ui.Text("لا توجد أسئلة", "No questions") : Ui.Items(Section.Questions.Count), Ui.Marks(Section.TotalMarks())])
</span>

@code {
    [Parameter, EditorRequired] public ExamSection Section { get; set; } = default!;
}
